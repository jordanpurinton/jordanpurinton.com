---
import Me from "./Me.astro";
import Description from "./Description.astro";
import LinkList from "./LinkList.astro";
import Greeting from "./react/Greeting";
---

<div class="app">
  <Me />
  <Greeting client:load />
  <Description />
  <LinkList />
</div>

<style>
  .app {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin: 0 1rem;
  }
</style>
