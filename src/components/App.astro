---
import Me from "./Me.astro";
import Description from "./Description.astro";
import LinkList from "./LinkList.astro";
import Greeting from "./react/Greeting";
---

<div class="app">
  <Me />
  <Greeting client:load />
  <Description />
  <LinkList />
</div>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .app {
    animation: fadeIn 0.5s ease-in forwards;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin: 0 1rem;
  }
</style>
