---
export interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, height=device-height, initial-scale=1.0"
		/>
		<meta
			name="description"
			content="Jordan Purinton personal website."
		/>
		<link rel="
			icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link
			rel="prefetch"
			href="/me.webm"
			crossorigin=""
			as="video"
			type="video/webm"
		/>
		<title>{title}</title>
		<script
			src="https://cdn.lr-ingest.com/LogRocket.min.js"
			crossorigin="anonymous"></script>
		<script>
			(window as any)?.LogRocket?.init?.("jordan-purinton/jordanpurintoncom");
		</script>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-XZWR4NNKRY"
		></script>
		<script>
			(window as any).dataLayer = (window as any).dataLayer || [];
			function gtag() {
				// @ts-ignore
				(dataLayer as any).push(arguments);
			}
			(gtag as any)("js", new Date());

			(gtag as any)("config", "G-XZWR4NNKRY");
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--primary-color: #00ff1e;
		--secondary-color: #ff00e1;
	}
	html {
		align-items: center;
		background: linear-gradient(rgb(0, 0, 0) 0%, rgb(0, 32, 14) 75%);
		display: flex;
		flex-direction: column;
		justify-content: center;
		font-family: monospace;
		font-kerning: none;
		height: 100vh;
		width: 100%;
	}
	body {
		background-attachment: fixed;
		margin: 0;
		overscroll-behavior: none;
	}
	a,
	b,
	p,
	h1,
	h2,
	h3,
	button {
		color: var(--primary-color);
		margin: 0;
	}
	[astro-icon] {
		color: var(--primary-color);
	}
	[astro-icon]:hover {
		color: var(--secondary-color);
		transition: ease-in 0.25s;
	}
	div {
		color: var(--primary-color);
	}
	button {
		background-color: #111;
	}
</style>
